{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Invoicelyzer: Process Invoice",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/main.py",
            "console": "integratedTerminal",
            "args": [
                "${file}"
            ],
            "envFile": "${workspaceFolder}/.env",
            "env": {
                "INVOICELYZER_EMAIL_ENABLED": "false",
                "INVOICELYZER_PDF_STORAGE_DIR": "${workspaceFolder}/data/invoices/pdf",
                "INVOICELYZER_OUTPUT_DIR": "${workspaceFolder}/data/invoices/processed",                
            },            
            "justMyCode": true
        },
        {
            "name": "Invoicelyzer: Process Invoice (Debug)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/main.py",
            "console": "integratedTerminal",
            "args": [
                "${file}"
            ],
            "envFile": "${workspaceFolder}/.env",
            "env": {
                "INVOICELYZER_EMAIL_ENABLED": "false",
                "INVOICELYZER_PDF_STORAGE_DIR": "${workspaceFolder}/data/invoices/pdf",
                "INVOICELYZER_OUTPUT_DIR": "${workspaceFolder}/data/invoices/processed",                
                "INVOICELYZER_LOG_LEVEL": "DEBUG"
            },
            "justMyCode": true
        },
        {
            "name": "Invoicelyzer: Email Monitor",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/main.py",
            "console": "integratedTerminal",
            "args": [
                "--monitor-email"
            ],
            "envFile": "${workspaceFolder}/.env",
            "justMyCode": true,
            "env": {
                "INVOICELYZER_PDF_STORAGE_DIR": "${workspaceFolder}/data/invoices/pdf",
                "INVOICELYZER_OUTPUT_DIR": "${workspaceFolder}/data/invoices/processed",
                "INVOICELYZER_LOG_LEVEL": "DEBUG"
            },
        },
        {
            "name": "Invoicelyzer: Email Monitor (Single Check - Debug)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/main.py",
            "console": "integratedTerminal",
            "args": [
                "--monitor-email"
            ],
            "envFile": "${workspaceFolder}/.env",
            "env": {
                "INVOICELYZER_EMAIL_CONTINUOUS": "false",
                "INVOICELYZER_PDF_STORAGE_DIR": "${workspaceFolder}/data/invoices/pdf",
                "INVOICELYZER_OUTPUT_DIR": "${workspaceFolder}/data/invoices/processed",
                "INVOICELYZER_LOG_LEVEL": "DEBUG"
            },
            "justMyCode": true
        },
        {
            "name": "Invoicelyzer: Reset Schema",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/invoicelyzer-cli.py",
            "console": "integratedTerminal",
            "args": [
                "reset"
            ],
            "envFile": "${workspaceFolder}/.env",
            "justMyCode": true
        }
    ]
}